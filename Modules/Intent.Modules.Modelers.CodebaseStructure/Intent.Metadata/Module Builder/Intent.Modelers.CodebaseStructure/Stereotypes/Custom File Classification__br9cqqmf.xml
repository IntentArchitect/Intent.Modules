<?xml version="1.0" encoding="utf-8"?>
<stereotypeDefinition id="1a5d919b-7ca2-4f2f-8a0d-0995aa6b02ac" version="3.1.0">
  <comment>Classifies custom (non-generated) files under a folder or project by classification and severity, scoped by a glob. Applied manually by users; the same stereotype may be applied multiple times to the same folder/project to classify different subsets of its custom files. Only ever consulted for files with no output-log entry - generated files are classified via their template's Output Classification instead.</comment>
  <name>Custom File Classification</name>
  <targetMode>filter-function</targetMode>
  <targetTypes />
  <targetReferenceTypes />
  <targetFilterFunction>// Only applicable where the element's specialization (its Element/Package Settings) or an
// extension of it (Element/Package Extension) has opted in via "Allows Custom File Classification".
return element.hasTrait("60fd85c8-5de8-45b6-9ba7-570cc701c3ab");</targetFilterFunction>
  <applyMode>manually</applyMode>
  <icon type="UrlImagePath" source="data:image/svg+xml;base64," />
  <displayIcon>false</displayIcon>
  <displayIconFunction>return false;</displayIconFunction>
  <displayAsAnnotation>false</displayAsAnnotation>
  <displayAsText>true</displayAsText>
  <autoAdd>false</autoAdd>
  <allowMultipleApplies>true</allowMultipleApplies>
  <parentFolderId>6537e6dd-d401-4065-a843-627fe0c89efb</parentFolderId>
  <order>0</order>
  <packageId>525868ff-adc0-4ab6-a90e-352288da941f</packageId>
  <packageName>Intent.Modelers.CodebaseStructure</packageName>
  <properties>
    <property id="bc57e41f-e7cb-4e84-b64c-42f3a4f23c8b">
      <hint>Free-text classification, e.g. security, infrastructure.</hint>
      <name>Classification</name>
      <type>string</type>
      <controlType>text</controlType>
      <optionsSource>n/a</optionsSource>
    </property>
    <property id="1f903649-4ed0-4c2b-b288-34dedacdff05">
      <hint>Severity level. Always stored as the lower-case option name, never a number.</hint>
      <name>Severity</name>
      <type>string</type>
      <controlType>select</controlType>
      <optionsSource>options</optionsSource>
      <valueOptions>
        <option>low</option>
        <option>medium</option>
        <option>high</option>
        <option>critical</option>
      </valueOptions>
    </property>
    <property id="14dd36e5-eee3-4b8f-9868-99b965703d23">
      <hint>Glob evaluated against a file's path relative to the folder/project this is applied to (e.g. **/*.sql, Migrations/**). Empty means **/*.</hint>
      <name>Glob</name>
      <type>string</type>
      <controlType>text</controlType>
      <optionsSource>n/a</optionsSource>
    </property>
  </properties>
</stereotypeDefinition>