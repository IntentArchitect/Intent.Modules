  <mappableElementPackageExtensions />
  <scripts>
    <script name="Connect to Services Script" id="282c83f2-714a-4010-9901-8a04a837b4e8">
      <script>async function connectToServices(packageElement) {
    const candidates = await getAvailablePackageReferences();
    const servicePackages = candidates.filter(c =&gt; c.packageType === "Services Package");
    const domainPackages = candidates.filter(c =&gt; c.packageType === "Domain Package");

    if (servicePackages.length === 0) {
        await dialogService.info("No connectable service packages found.");
        return;
    }

    const nameCounts = {};
    for (const c of candidates) {
        nameCounts[c.name] = (nameCounts[c.name] || 0) + 1;
    }
    const describe = c =&gt; nameCounts[c.name] &gt; 1 ? (c.name + " (" + c.source + ")") : c.name;

    let selection;
    try {
        selection = await dialogService.openForm({
            title: "Connect to Services(s)",
            submitButtonText: "Done",
            minWidth: "600px",
            maxWidth: "80%",
            fields: [
                {
                    id: "packages",
                    fieldType: "multi-select",
                    label: "Services Packages",
                    isRequired: true,
                    selectOptions: servicePackages.map(c =&gt; ({ id: c.packageId, description: describe(c) }))
                }
            ]
        });
    } catch (e) {
        selection = null;
    }

    const selectedServiceIds = selection &amp;&amp; selection.packages;
    if (!selectedServiceIds || selectedServiceIds.length === 0) {
        return;
    }

    const selected = servicePackages.filter(c =&gt; selectedServiceIds.includes(c.packageId));
    const addedSourceKeys = new Set();
    for (const candidate of selected) {
        packageElement.addReference(candidate.absolutePath, candidate.sourceType === "module" ? candidate.source : undefined);
        addedSourceKeys.add(candidate.sourceType + "|" + candidate.source);
    }

    const seenDomainIds = new Set();
    for (const candidate of domainPackages) {
        if (seenDomainIds.has(candidate.packageId)) {
            continue;
        }
        seenDomainIds.add(candidate.packageId);

        if (addedSourceKeys.has(candidate.sourceType + "|" + candidate.source)) {
            packageElement.addReference(candidate.absolutePath, candidate.sourceType === "module" ? candidate.source : undefined);
        }
    }
}</script>
    </script>
  </scripts>
</settings>