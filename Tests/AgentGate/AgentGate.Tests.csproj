<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      The generated gate is one file-based app. AGENT_GATE_TESTS switches off its top-level entry
      point, and FileBasedProgram lets the compiler accept its "#!" and "#:" lines inside a project.
    -->
    <DefineConstants>$(DefineConstants);AGENT_GATE_TESTS</DefineConstants>
    <Features>$(Features);FileBasedProgram</Features>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Links the module's actual generated output directly - the same gate.cs a consuming repo gets
      in each harness's "hooks/gate/" - rather than a parallel copy kept beside the tests, so this
      suite can only ever drift out of sync with what ships by failing to compile. Its behaviour as
      a running app (argument parsing, exit codes, the SDK floor) is exercised by GateSmokeTests,
      which shells out to the real file-based app.
    -->
    <!--
      Linked from the TEST application, not the repo root. The repo root's ".agents" is generated by
      the dogfood app (Modules/ModuleBuilderAiSkills), which exists to be what an agent working in
      this repo actually runs on - it carries only .agents/.claude/.opencode and deliberately never
      gains the other harnesses. Tests/ModuleBuilderSkills is the application that carries all of
      them and is where harnesses are exercised. Pointing these unit tests at the dogfood app meant
      every gate-source change had to be regenerated through one application to run the tests and a
      different one to test the harnesses, which is a standing source of confusion.
    -->
    <Compile Include="..\ModuleBuilderSkills\.agents\hooks\gate\gate.cs" LinkBase="GeneratedGateSources" />
    <!--
      The module's own hook-command and hook-config-merge sources, compiled here as they are rather
      than restated: the module assembly cannot be referenced from this project, and an earlier
      hand-maintained port of the merge rules was a seam a template change could slip through
      unnoticed. These files have no Intent dependency for exactly this reason.
    -->
    <Compile Include="..\..\Modules\Intent.Modules.ModuleBuilder.AI.Workflow\Templates\Hooks\GateCommands.cs;..\..\Modules\Intent.Modules.ModuleBuilder.AI.Workflow\Templates\Hooks\HookConfigMerge.cs;..\..\Modules\Intent.Modules.ModuleBuilder.AI.Workflow\Templates\Hooks\HarnessHookSets.cs" LinkBase="ModuleSources" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
