<?xml version="1.0" encoding="utf-8"?>
<applicationTemplate type="application-template">
  <id>Test Architecture Template</id>
  <version>1.0.0</version>
  <supportedClientVersions>[3.0.0,5.0.0)</supportedClientVersions>
  <displayName>Test Architecture Template</displayName>
  <shortDescription>A minimal architecture template used to validate the App Templates designer end-to-end.</shortDescription>
  <longDescription>Installs Visual Studio project structure, a Domain model, and Web API Services (optionally with CQRS) via Component Modules. Used as a regression test fixture for the Intent Application Template Builder.</longDescription>
  <authors>Intent Architect</authors>
  <priority>0</priority>
  <icon type="UrlImagePath" source="data:image/svg+xml;base64," />
  <defaults>
    <name>TestArchitectureApp</name>
    <relativeOutputLocation>${application.name}</relativeOutputLocation>
    <placeInSameDirectory>false</placeInSameDirectory>
    <separateIntentFiles>true</separateIntentFiles>
    <setGitIgnoreEntries>true</setGitIgnoreEntries>
    <createFolderForSolution>true</createFolderForSolution>
  </defaults>
  <componentGroups>
    <group name="Project Structure">
      <selectionMode>allow-single-only</selectionMode>
      <components>
        <component id="52bb613c-8749-4874-b47f-50805cdd91f7" name="Visual Studio Projects" included="true" required="true">
          <description>Sets up the Visual Studio solution and project layout.</description>
          <icon type="UrlImagePath" source="data:image/svg+xml;base64," />
          <modules>
            <module id="Intent.VisualStudio.Projects" version="4.1.7">
              <includedByDefault>true</includedByDefault>
              <required>true</required>
            </module>
          </modules>
          <dependencies />
        </component>
      </components>
    </group>
    <group name="Domain Modeling">
      <selectionMode>allow-single-only</selectionMode>
      <components>
        <component id="9766c736-9286-4e8f-a6fa-87ac538f5a6f" name="Domain Model" included="true" required="true">
          <description>Adds the Domain designer for modeling entities and relationships.</description>
          <icon type="UrlImagePath" source="data:image/svg+xml;base64," />
          <modules>
            <module id="Intent.Modelers.Domain" version="3.13.2">
              <includedByDefault>true</includedByDefault>
              <required>true</required>
            </module>
          </modules>
          <dependencies />
        </component>
      </components>
    </group>
    <group name="Services">
      <selectionMode>allow-multiple</selectionMode>
      <components>
        <component id="03ea73e1-276c-47e9-93f4-6a971108e330" name="Web API Services" included="true" required="false">
          <description>Adds the Services designer for describing an application's web services.</description>
          <icon type="UrlImagePath" source="data:image/svg+xml;base64," />
          <modules>
            <module id="Intent.Modelers.Services" version="4.0.16">
              <includedByDefault>true</includedByDefault>
              <required>true</required>
            </module>
            <module id="Intent.Modelers.Services.CQRS" version="6.0.8">
              <includedByDefault>true</includedByDefault>
              <required>false</required>
            </module>
          </modules>
          <dependencies />
        </component>
      </components>
    </group>
  </componentGroups>
  <additionalSettings>
    <group id="698a0413-fb1f-4b5a-a110-2b85eafa8a06" title="General Settings">
      <settings>
        <setting id="Target Framework" title="Target Framework" type="select">
          <hint>The .NET target framework moniker to generate projects against.</hint>
          <defaultValue>net9.0</defaultValue>
          <isRequired>true</isRequired>
          <options>
            <option value="net8.0" description="net8.0" />
            <option value="net9.0" description="net9.0" />
          </options>
        </setting>
      </settings>
    </group>
  </additionalSettings>
</applicationTemplate>