{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "dotnet run .cursor/hooks/gate/gate.cs -- warm"
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "command": "dotnet run .cursor/hooks/gate/gate.cs --no-build -- guard-write --harness cursor; exit $LASTEXITCODE",
        "matcher": "Write|Delete",
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "type": "command",
        "command": "dotnet run .cursor/hooks/gate/gate.cs --no-build -- guard-version --harness cursor; exit $LASTEXITCODE",
        "matcher": ".*run_designer_script.*",
        "failClosed": true
      }
    ],
    "stop": [
      {
        "type": "command",
        "command": "dotnet run .cursor/hooks/gate/gate.cs --no-build -- close-out --harness cursor"
      }
    ]
  }
}