{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dotnet run .codex/hooks/gate/gate.cs -- warm"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet run .codex/hooks/gate/gate.cs --no-build -- guard-write --harness codex || exit 2",
            "commandWindows": "dotnet run .codex/hooks/gate/gate.cs --no-build -- guard-write --harness codex; if ($LASTEXITCODE -ne 0) { exit 2 }"
          }
        ]
      },
      {
        "matcher": ".*run_designer_script.*",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet run .codex/hooks/gate/gate.cs --no-build -- guard-version --harness codex || exit 2",
            "commandWindows": "dotnet run .codex/hooks/gate/gate.cs --no-build -- guard-version --harness codex; if ($LASTEXITCODE -ne 0) { exit 2 }"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dotnet run .codex/hooks/gate/gate.cs --no-build -- close-out --harness codex"
          }
        ]
      }
    ]
  }
}