{
  "version": "v1",
  "hooks": [
    {
      "name": "intent-agent-gate-warm",
      "trigger": "SessionStart",
      "action": { "type": "command", "command": "dotnet run .kiro/hooks/gate/gate.cs -- warm" }
    },
    {
      "name": "intent-agent-gate-guard-write",
      "trigger": "PreToolUse",
      "matcher": "write|fs_write|fsWrite|str_replace|fs_append|delete_file",
      "action": { "type": "command", "command": "dotnet run .kiro/hooks/gate/gate.cs --no-build -- guard-write --harness kiro; exit $LASTEXITCODE" }
    },
    {
      "name": "intent-agent-gate-guard-version",
      "trigger": "PreToolUse",
      "matcher": ".*run_designer_script.*",
      "action": { "type": "command", "command": "dotnet run .kiro/hooks/gate/gate.cs --no-build -- guard-version --harness kiro; exit $LASTEXITCODE" }
    },
    {
      "name": "intent-agent-gate-close-out",
      "trigger": "Stop",
      "action": { "type": "command", "command": "dotnet run .kiro/hooks/gate/gate.cs --no-build -- close-out --harness kiro" }
    }
  ]
}